{
  "name": "autoeditor-desktop",
  "version": "0.1.0",
  "description": "Private video editing system built by Omar Marabha",
  "main": "main.js",
  "author": "Omar Marabha",
  "homepage": "https://www.instagram.com/ceomarabha/",
