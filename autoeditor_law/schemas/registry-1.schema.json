{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autoeditor:schema:registry:1",
  "title": "AutoEditor schema registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "contract_id",
    "registry_version",
    "schemas",
    "legacy_schema_ids",
    "identifier_namespaces",
    "retired_ambiguous_capabilities"
  ],
  "properties": {
    "schema_id": {"const": "urn:autoeditor:schema:registry:1"},
    "contract_id": {"const": "autoeditor-2034-contract/1"},
    "registry_version": {"const": 1},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/schemaEntry"}
    },
    "legacy_schema_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "identifier_namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "check_id",
        "algorithm_id",
        "payload_schema_id",
        "policy_id",
        "artifact_contract_id"
      ],
      "properties": {
        "capability_id": {"const": "urn:autoeditor:capability:"},
        "check_id": {"const": "urn:autoeditor:check:"},
        "algorithm_id": {"const": "urn:autoeditor:algorithm:"},
        "payload_schema_id": {"const": "urn:autoeditor:schema:"},
        "policy_id": {"const": "urn:autoeditor:policy:"},
        "artifact_contract_id": {"const": "urn:autoeditor:artifact-contract:"}
      }
    },
    "retired_ambiguous_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "schemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "status", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^urn:autoeditor:schema:"},
        "path": {"type": "string", "pattern": "^[^/].*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["current", "frozen"]},
        "kind": {"enum": ["registry", "archive", "adapter", "evidence"]}
      }
    }
  }
}
