# Render daemon configuration (no real secrets here, ever)
AUTOEDITOR_WEB_API=https://autoeditor-web.YOUR-SUBDOMAIN.workers.dev
WORKER_TOKEN=generate-with:python3 -c "import secrets;print(secrets.token_urlsafe(32))"
KEY_WRAP_SECRET=same-value-as-the-worker-secret-of-this-name
WORK_DIR=/tmp/autoeditor-web
# ENGINE_CMD=python3 -m autoeditor        # default
# AUTOEDITOR_FFMPEG=/opt/homebrew/bin/ffmpeg

# Cloudflare Worker secrets are NOT set via files; use:
#   npx wrangler secret put KEY_WRAP_SECRET
#   npx wrangler secret put WORKER_TOKEN
#   npx wrangler secret put ADMIN_TOKEN
