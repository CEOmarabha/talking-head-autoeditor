{
  "dependency_exceptions": [
    {
      "classification": "no-linkage-runtime-metadata",
      "name": "ca-certificates",
      "reason": "openssl@3 declares this dependency with Homebrew's :no_linkage qualifier; it is not in the shipped Mach-O load closure"
    },
    {
      "classification": "build-tool",
      "name": "cmake",
      "reason": "used to build svt-av1 and x265; no CMake binary or library is shipped"
    },
    {
      "classification": "unsupported-host-conditional-build-tool",
      "name": "gcc",
      "reason": "the x264 formula selects GCC only for obsolete Clang build versions at or below 902, outside the audited runners"
    },
    {
      "classification": "build-tool",
      "name": "meson",
      "reason": "used to build dav1d and libvmaf; no Meson runtime is shipped"
    },
    {
      "classification": "build-tool",
      "name": "nasm",
      "reason": "selected only on Intel for assembly during builds; no NASM runtime is shipped"
    },
    {
      "classification": "build-tool",
      "name": "ninja",
      "reason": "used to build dav1d and libvmaf; no Ninja runtime is shipped"
    },
    {
      "classification": "build-tool",
      "name": "pkgconf",
      "reason": "used while building ffmpeg and lame; no pkgconf runtime is shipped"
    },
    {
      "classification": "non-shipped-ffplay-runtime",
      "name": "sdl2-compat",
      "reason": "declared by ffmpeg for ffplay, while the shipped ffmpeg and ffprobe Mach-O closure contains no SDL load"
    },
    {
      "classification": "transitive-non-shipped-ffplay-runtime",
      "name": "sdl3",
      "reason": "transitive runtime metadata from sdl2-compat; the shipped ffmpeg and ffprobe Mach-O closure contains no SDL load"
    },
    {
      "classification": "build-tool-from-macos",
      "name": "vim",
      "reason": "libvmaf uses the macOS-provided xxd build tool; no Vim runtime is shipped"
    },
    {
      "classification": "build-tool",
      "name": "yasm",
      "reason": "the exact libvpx bottle-producing formula used Yasm on Intel; no Yasm runtime is shipped"
    }
  ],
