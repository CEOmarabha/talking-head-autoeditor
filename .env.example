# Copy this to `.env` and fill in the keys for the selected mode.
# Model mode requires DeepSeek. Run `make edit ... NO_LLM=1` for the
# explicit local heuristic.

# ---- the creative planner -------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Production reasoning is pinned to max by the provider contract.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- free stock b-roll (both have free tiers, 60 seconds to sign up) ------
# https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- optional: sound effects. Falls back to a synthesized kit ------------
# ELEVENLABS_API_KEY=

# ---- optional: push the finished video to your phone ---------------------
# Make a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- optional: your own clip library, colon-separated CSV catalogs --------
# CLIP_CATALOGS=/path/to/catalog.csv:/path/to/another.csv
