# Copy to `.env` and fill in what you have. EVERY line is optional —
# with an empty file you still get a finished, verified video.

# ---- the creative brain (pick ONE; ~1 cent per video on DeepSeek) ---------
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=deepseek-chat

# ---- free stock b-roll (both free tiers, 60 seconds to sign up) -----------
# https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- optional: sound effects (falls back to a synthesized kit) ------------
# ELEVENLABS_API_KEY=

# ---- optional: get the finished video pushed to your phone ---------------
# Make a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- optional: your own clip library, colon-separated CSV catalogs --------
# CLIP_CATALOGS=/path/to/catalog.csv:/path/to/another.csv
